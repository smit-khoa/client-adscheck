{
  "name": "adscheck-client",
  "version": "0.1.0",
  "private": true,
  "description": "Adscheck micro-frontend client (Vue 3 + Module Federation 2.0 + Rspack)",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" run dev",
    "dev:shell": "pnpm --filter @mf2/shell dev",
    "dev:adaccounts": "pnpm --filter @mf2/adaccounts dev",
    "dev:ads-manager": "pnpm --filter @mf2/ads-manager dev",
    "dev:extended-payment": "pnpm --filter @mf2/extended-payment dev",
    "build": "node scripts/build.mjs",
    "assemble": "node scripts/assemble-dist.mjs",
    "typecheck": "turbo run typecheck",
    "verify:same-origin": "node scripts/verify-same-origin-remotes.mjs",
    "verify:dist": "node scripts/verify-dist-assembly.mjs",
    "verify:catalog": "node scripts/verify-catalog-coverage.mjs",
    "verify:features": "node scripts/verify-feature-docs.mjs",
    "verify:pr-split": "node scripts/verify-pr-split.mjs",
    "verify:all": "node scripts/verify-catalog-coverage.mjs && node scripts/verify-feature-docs.mjs && node scripts/verify-pr-split.mjs",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache @mf-types",
    "prepare": "husky",
    "postinstall": "node scripts/ensure-owners.mjs"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.5.2",
    "husky": "^9.1.7",
    "turbo": "^2.9.16",
    "typescript": "^5.6.3"
  }
}
