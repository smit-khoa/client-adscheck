{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**"],
      "env": [
        "NODE_ENV",
        "DASHBOARD_URL",
        "BASE_PATH",
        "ADACCOUNTS_REMOTE_URL",
        "ADS_MANAGER_REMOTE_URL",
        "EXTENDED_PAYMENT_REMOTE_URL"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
