# CODEOWNERS — required reviewers per path.
# NOTE: placeholder handles below (@tech-lead, @dev-a, @dev-b) MUST be replaced with
# real GitHub teams/users, else GitHub silently ignores the rule. Branch protection on
# `main` must also enable "Require review from Code Owners" for this to take effect.

# Shared packages — a breaking change here affects EVERY app at runtime (MF singletons),
# so changes require lead review. This enforces the additive + PR-split discipline.
/packages/shared-store/   @tech-lead
/packages/shared-ui/      @tech-lead
/packages/shared-types/   @tech-lead

# App ownership — each remote owned by its developer.
/apps/adaccounts/    @dev-a
/apps/ads-manager/   @dev-b
/apps/shell/         @tech-lead

# Build/CI config — lead review.
/turbo.json              @tech-lead
/.github/                @tech-lead
