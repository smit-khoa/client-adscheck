# Shell (host) environment variables
# Dev: fallback trỏ về localhost:301x (xem owners.json).
# Prod: same-origin — remote URL tự suy ra BASE_PATH-relative, KHÔNG cần điền URL.

# Dashboard redirect (dùng cho DefinePlugin). API gateway được resolve runtime theo domain: gateway.<team|vn>.
DASHBOARD_URL=https://dashboard.smit.team

# Path prefix khi serve dưới sub-path (mặc định "/"). Prefix cả publicPath lẫn remote URL.
BASE_PATH=/

# (Tùy chọn) Override URL 1 remote — không trailing slash. Để trống nếu dùng same-origin mặc định.
# ADACCOUNTS_REMOTE_URL=https://cdn.example.com/adaccounts
# ADS_MANAGER_REMOTE_URL=https://cdn.example.com/ads-manager
